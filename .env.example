# Copy to .env and fill in. Never commit .env (it is git-ignored).
# The server validates these at startup and stops with a clear message if one is wrong.

# --- Supabase (required) ------------------------------------------------------
# Dashboard -> Project Settings -> API Keys. Local values: `npx supabase status`.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or legacy "anon" key. Safe to expose to browsers.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Secret key (sb_secret_...) or legacy "service_role" key. SERVER ONLY - full database access.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me

# --- Accounts -------------------------------------------------------------------
# Usernames like judge01grp1sc are turned into internal Supabase Auth identifiers
# (judge01grp1sc@judges.invalid). Must end in a reserved, non-deliverable TLD:
# .invalid, .test, .example or .localhost. No mail is ever sent to these.
# Do not change after accounts exist: existing users would no longer be able to log in.
AUTH_EMAIL_DOMAIN=judges.invalid

# How long a login lasts, in hours (1-168).
SESSION_MAX_AGE_HOURS=12

# --- Node deployments only (read at BUILD time) ---------------------------------
# Public URL of the site, so form submissions pass SvelteKit's CSRF origin check.
# Not needed on Vercel, or behind a proxy configured with PROTOCOL_HEADER/HOST_HEADER.
# ORIGIN=https://judging.example.org

# --- Optional: email reports via Resend (https://resend.com) ---------------------
# If any of these is missing, emailing is disabled and PDF download still works.
# REPORT_EMAIL_TO=organiser@example.org
# RESEND_API_KEY=re_replace_me
# EMAIL_FROM="Event Results <results@your-verified-domain.org>"